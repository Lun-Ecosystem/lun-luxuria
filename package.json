{
  "name": "lun-luxuria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Un compagnon vocal sur ton poste : seul sur un modèle, ou relié à un serveur.",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "voix": "uv run voix/service.py",
    "tauri": "tauri",
    "banc": "vitest run src/listen/banc.test.ts --mode banc",
    "scenarios": "vitest run src/presence/scenarios.test.ts --mode scenarios"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-http": "2.8.3",
    "bits-ui": "^2.20.0",
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
